# Canonical base URL (used for self-referencing canonical tags and the sitemap).
# On Vercel this is auto-detected from VERCEL_PROJECT_PRODUCTION_URL, so you can
# leave this unset unless you serve from a custom domain.
NEXT_PUBLIC_SITE_URL=https://explore-shanxi.vercel.app

# Cloudflare Turnstile (anti-bot). Site key is public, secret is server-only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (persistent rate limiting). Server-only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only secrets: never prefix with NEXT_PUBLIC_
RESEND_API_KEY=
INQUIRY_FROM_EMAIL=Explore Shanxi <inquiries@your-verified-domain.com>
INQUIRY_TO_EMAIL=
